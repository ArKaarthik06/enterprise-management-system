PORT=5000
MONGO_URI=mongodb://localhost:27017/enterprise_marketplace
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
JWT_SECRET=change_me

# ---------- AI layer ----------
# API key for the language model (OpenRouter key by default; an OpenAI key also works)
LLM_API_KEY=
# Optional settings (defaults shown)
LLM_BASE_URL=https://openrouter.ai/api/v1   # use https://api.openai.com/v1 for a direct OpenAI key
AI_ENABLED=true
AI_AGENT_MODEL=openai/gpt-4.1-mini          # with a direct OpenAI key use e.g. gpt-4.1-mini
AI_CLASSIFIER_MODEL=openai/gpt-4o-mini
EMBEDDINGS_PROVIDER=auto                    # auto | local | hash
